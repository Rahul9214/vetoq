# Copy to .env for local development; never commit .env.
# These are placeholders, not credentials. Replace the password in BOTH values.
POSTGRES_PORT=5432
POSTGRES_DB=vetoq
POSTGRES_USER=vetoq
POSTGRES_PASSWORD=replace-with-local-password
VETOQ_DATABASE_URL=postgresql://vetoq:replace-with-local-password@127.0.0.1:5432/vetoq
VETOQ_ENVIRONMENT=development
VETOQ_TRUSTED_HOSTS=["localhost","127.0.0.1","[::1]"]
GROQ_API_KEY=replace-with-groq-api-key
VETOQ_AI_PROVIDER=groq
VETOQ_AI_MODEL=openai/gpt-oss-120b
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace-with-clerk-publishable-key
CLERK_SECRET_KEY=replace-with-clerk-secret-key
VETOQ_CLERK_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Shell-only optional override used by `pnpm dev:api`: VETOQ_API_PORT=18000
# Shell-only, for integration tests and `pnpm verify:groq`; the name must end in _test:
# VETOQ_TEST_DATABASE_URL=postgresql://vetoq:replace-with-local-password@127.0.0.1:5432/vetoq_test
# Web-only apps/web/.env.local: the same two Clerk keys plus optional
# VETOQ_API_URL=http://127.0.0.1:18000 when the API uses an alternate port.
# Production: explicit trusted hosts, real database password, and sslmode=verify-full.
